{
  "expo": {
    "name": "Mis finanzas",
    "slug": "mis-finanzas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/fi-icons/icon.png",
    "scheme": "misfinanzas",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/fi-icons/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFAF7",
        "foregroundImage": "./assets/fi-icons/foreground.png",
        "monochromeImage": "./assets/fi-icons/monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.misfinanzas.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/fi-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EC",
          "image": "./assets/fi-icons/splash.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
